    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code: relax analyzers that target library/production code. -->
    <NoWarn>$(NoWarn);xUnit1051;CA1725;CA1707;CA1515;CA1861;CA2000;CA1062;CA1001;CA1849;CA1031;CA5394;CA1859;CA1822;CA2234;CA1054;CA1056;CA1305;CA1307;CA1310;CA1863;CA1860;CA2007</NoWarn>
