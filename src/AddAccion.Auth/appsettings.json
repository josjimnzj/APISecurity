{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Auth": {
    "Issuer": "https://auth.addaccion.com",
    "RequireHttps": true,
    "SigningKeys": {
      "Path": "/run/secrets/signing-keys",
      "ActiveKey": ""
    },
    "Tokens": {
      "AuthorizationCodeLifetimeSeconds": 60,
      "IdTokenLifetimeSeconds": 300,
      "ClientAssertionMaxLifetimeSeconds": 300,
      "ClockSkewSeconds": 30
    },
    "Login": {
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 900,
      "BrandName": "AddACCION"
    },
    "Caching": {
      "ClientCacheSeconds": 60,
      "ScopeCacheSeconds": 120
    },
    "RateLimits": {
      "Enabled": true,
      "TokenBurst": 100,
      "TokenPerSecond": 50,
      "LoginPermitsPerWindow": 10,
      "LoginWindowSeconds": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Users": {
      "UseVarcharParameters": false
    },
    "Proxy": {
      "KnownNetworks": [],
      "KnownProxies": []
    },
    "Cleanup": {
      "Enabled": true,
      "IntervalSeconds": 900,
      "BatchSize": 5000
    }
  }
}
